# 學生專注度與異常行為分析系統 — 環境變數設定範例 (.env.example)

# MongoDB 設定 (本機 MongoDB 8.3.7 預設位址)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=student_analytics

# FastAPI 後端設定
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_PORT=8000

# 攝影機與推論參數
CAMERA_ID=0
TARGET_FPS=5
IMG_SZ=640

# 門檻與分數設定
POSE_CONF_THRESHOLD=0.45
SLEEPING_RATIO=0.12
SLEEPING_PITCH_LOW=-60
SLEEPING_PITCH_HIGH=70
SLEEPING_SHOULDER_TILT_RATIO=0.45
SLEEPING_CONFIRM_FRAMES=6
SLEEPING_RELEASE_FRAMES=3
PHONE_PITCH_THRESHOLD=-35
BOARD_YAW_THRESHOLD=30
BOARD_PITCH_THRESHOLD=25

# 狀態機與持久化視窗
FSM_NOISE_WINDOW=3.0
FSM_CONFIRM_WINDOW=10.0
DB_BATCH_SIZE=500
FLUSH_INTERVAL=3.0

# CORS 跨網域存取 (預設允許所有來源)
CORS_ORIGINS=["*"]
TIMEZONE=Asia/Taipei
RETENTION_DAYS=365
PII_BLUR_KERNEL=31
LOG_LEVEL=INFO

# Cloudflare 具名 Tunnel (選用，固定網址)：兩者皆填才會啟用，否則自動使用臨時 Quick Tunnel
# 1) Cloudflare Zero Trust > Networks > Tunnels 建立 Tunnel，複製 token
# 2) 於該 Tunnel 新增 Public Hostname，Service 指向 http://localhost:8000
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_PUBLIC_URL=
